    "academicons": "^1.9.2",
    "dayjs": "^1.10.4",
    "dompurify": "^3.0.6",
    "gh-pages": "^3.1.0",
    "node-sass": "^9.0.0",
    "prop-types": "^15.7.2",
    "raw.macro": "^0.4.2",
    "react": "^17.0.1",
    "react-burger-menu": "^3.0.3",
    "react-dom": "^17.0.1",
